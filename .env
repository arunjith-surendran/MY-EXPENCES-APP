# Copy to .env and fill in. These values are bundled into the app, so never put secrets here.
# After editing, restart Metro with a clean cache: yarn start --reset-cache

# Backend (MY-EXPENCES-BACKEND). Leave empty in development to use
# http://localhost:3000 (iOS) / http://10.0.2.2:3000 (Android emulator).
# Release builds need a deployed HTTPS URL.
API_URL=https://my-expences-mocha.vercel.app

# Google Cloud Console → APIs & Services → Credentials
# "Web application" client ID; must also be in the backend's GOOGLE_CLIENT_IDS
GOOGLE_WEB_CLIENT_ID=609237671144-r1jh3th7cjcdbkh398ujcb1g6qnmqnk2.apps.googleusercontent.com
# "iOS" client ID; its reversed form must be a URL scheme in ios/Expences/Info.plist
GOOGLE_IOS_CLIENT_ID=609237671144-3f1gvler4dnim29difnd441aajlhcd03.apps.googleusercontent.com

PRIVACY_POLICY_URL=https://your-domain.com/privacy
TERMS_URL=https://your-domain.com/terms
